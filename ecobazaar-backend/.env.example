# =============================================================
# EcoBazaar Backend — Environment Variables Template
# =============================================================
# Copy this file to .env and fill in your real values.
# .env is listed in .gitignore and will NEVER be committed.
#
# These variables override the defaults in application.properties.
# For local development, the defaults in application.properties
# are used automatically — you only need this file in production.
# =============================================================

# PostgreSQL Database
DATABASE_URL=jdbc:postgresql://localhost:5434/EcoBazar2
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_password_here

# JWT Signing Secret — must be >= 32 characters (256-bit minimum)
# Generate a strong random value for production, e.g.:
#   openssl rand -hex 64
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173
